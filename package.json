    "url": "git+https://github.com/justinjsp/homebridge-grizzl-e.git"
  },
  "bugs": {
    "url": "https://github.com/justinjsp/homebridge-grizzl-e/issues"
  },
  "homepage": "https://github.com/justinjsp/homebridge-grizzl-e#readme",
  "funding": [
    {
      "type": "paypal",
      "url": "https://paypal.me/justinjsp"
    },
    {
      "type": "buymeacoffee",
      "url": "https://www.buymeacoffee.com/justinjsp"
    }
  ],
  "files": [
    "dist",
    "config.schema.json"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
